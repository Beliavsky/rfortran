// Seed grammar to evolve toward full Fortran 90. 
grammar;

use crate::ast::{Program, Stmt, Expr, TypeSpec, CaseBlock, CaseItem, CaseOrDefault, Implicit, ImplicitRule, LetterRange};
use crate::lexer::TokenKind;

extern {
    type Location = usize;
    enum TokenKind {
        KW_TYPE => TokenKind::KwType,
        KW_CLASS => TokenKind::KwClass,
        KW_PROCEDURE => TokenKind::KwProcedure,
        KW_INTERFACE => TokenKind::KwInterface,
        KW_OPERATOR => TokenKind::KwOperator,
        KW_KIND => TokenKind::KwKind,
        KW_ONLY => TokenKind::KwOnly,
        END_INTERFACE_NAME => TokenKind::EndInterfaceName(<String>),
        END_UNIT_NAME => TokenKind::EndUnitName(<String>),
        BARE_END => TokenKind::BareEnd,
        DEFINED_OP => TokenKind::DefinedOperator(<String>),
        PERCENT => TokenKind::Percent,
        ARROW => TokenKind::Arrow,
        LBRACKET => TokenKind::LBracket,
        RBRACKET => TokenKind::RBracket,
        KW_ERROR => TokenKind::KwError,
        KW_ALLOCATE => TokenKind::KwAllocate,
        KW_DEALLOCATE => TokenKind::KwDeallocate,
        KW_NULLIFY => TokenKind::KwNullify,
        KW_PROGRAM => TokenKind::KwProgram,
        KW_END => TokenKind::KwEnd,
        KW_FUNCTION => TokenKind::KwFunction,
        KW_RESULT => TokenKind::KwResult,
        KW_PURE => TokenKind::KwPure,
        KW_IMPURE => TokenKind::KwImpure,
        KW_RECURSIVE => TokenKind::KwRecursive,
        KW_ELEMENTAL => TokenKind::KwElemental,
        KW_FORALL => TokenKind::KwForall,
        KW_PARAMETER => TokenKind::KwParameter,
        KW_WHERE => TokenKind::KwWhere,
        KW_WHERE_BLOCK => TokenKind::KwWhereBlock,
        KW_ELSEWHERE => TokenKind::KwElseWhere,
        KW_ENDWHERE => TokenKind::KwEndWhere,
        KW_PUBLIC => TokenKind::KwPublic,
        KW_PRIVATE => TokenKind::KwPrivate,
        KW_RETURN => TokenKind::KwReturn,
        KW_IMPLICIT => TokenKind::KwImplicit,
        KW_NONE => TokenKind::KwNone,
        KW_PRINT => TokenKind::KwPrint,
        KW_PRINT_EMPTY => TokenKind::KwPrintEmpty,
        KW_READ => TokenKind::KwRead,
        KW_READ_EMPTY => TokenKind::KwReadEmpty,
        FILE_CONTROL => TokenKind::FileControl(<String>),
        FILE_POSITION => TokenKind::FilePosition(<String>),
        KW_WRITE => TokenKind::KwWrite,
        KW_WRITE_EMPTY => TokenKind::KwWriteEmpty,
        KW_IF => TokenKind::KwIf,
        KW_THEN => TokenKind::KwThen,
        KW_ELSE => TokenKind::KwElse,
        KW_ELSE_IF => TokenKind::KwElseIf,
    KW_DO => TokenKind::KwDo,
    KW_DO_UNBOUNDED => TokenKind::KwDoUnbounded,
    KW_ENDDO => TokenKind::KwEndDo,
    CONSTRUCT_NAME => TokenKind::ConstructName(<String>),
    END_LOOP_NAME => TokenKind::EndLoopName(<String>),
    NAMED_EXIT => TokenKind::NamedExit(<String>),
    NAMED_CYCLE => TokenKind::NamedCycle(<String>),
    KW_WHILE => TokenKind::KwWhile,
        KW_INTEGER => TokenKind::KwInteger,
        KW_REAL => TokenKind::KwReal,
        KW_DIMENSION => TokenKind::KwDimension,
        KW_DOUBLE => TokenKind::KwDouble,
        KW_PRECISION => TokenKind::KwPrecision,
        KW_CHARACTER => TokenKind::KwCharacter,
        KW_LOGICAL => TokenKind::KwLogical,
        KW_LEN => TokenKind::KwLen,
        ID => TokenKind::Ident(<String>),
        STR => TokenKind::Str(<String>),
        FLOAT => TokenKind::Float(<String>),
        INT => TokenKind::Integer(<String>),
        LABEL => TokenKind::StatementLabel(<String>),
        KW_CONTINUE => TokenKind::KwContinue,
        TRUE => TokenKind::True,
        FALSE => TokenKind::False,
        COMMA => TokenKind::Comma,
        STAR => TokenKind::Star,
    DCOLON => TokenKind::DColon,
    COLON => TokenKind::Colon,
        EQ => TokenKind::Eq,
        LPAREN => TokenKind::LParen,
        RPAREN => TokenKind::RParen,
        PLUS => TokenKind::Plus,
        MINUS => TokenKind::Minus,
        SLASH => TokenKind::Slash,
        POW => TokenKind::Pow,
        CONCAT => TokenKind::Concat,
        EQEQ => TokenKind::EqEq,
        NE => TokenKind::Ne,
        LT => TokenKind::Lt,
        GT => TokenKind::Gt,
        LE => TokenKind::Le,
        GE => TokenKind::Ge,
        AND => TokenKind::And,
        OR => TokenKind::Or,
        NOT => TokenKind::Not,
        EQV => TokenKind::Eqv,
        NEQV => TokenKind::Neqv,
        KW_SUBROUTINE => TokenKind::KwSubroutine,
        KW_CALL => TokenKind::KwCall,
        KW_CONTAINS => TokenKind::KwContains,
        KW_USE => TokenKind::KwUse,
        KW_MODULE => TokenKind::KwModule,
        KW_SELECT => TokenKind::KwSelect,
        KW_CASE => TokenKind::KwCase,
        KW_DEFAULT => TokenKind::KwDefault,
        KW_BLOCK => TokenKind::KwBlock,
        KW_EXIT => TokenKind::KwExit,
        KW_CYCLE => TokenKind::KwCycle,
        KW_STOP => TokenKind::KwStop,
        KW_STOP_EMPTY => TokenKind::KwStopEmpty,
    }
}

LeadingFuncs: Vec<Stmt> = {
    <f: FuncDef> => vec![f],
    <s: SubrDef> => vec![s],
    <d: PreFuncDecl> => d,
    <m: ModuleDef> => vec![m],
    <mut v: LeadingFuncs> <f: FuncDef> => { v.push(f); v },
    <mut v: LeadingFuncs> <s: SubrDef> => { v.push(s); v },
    <mut v: LeadingFuncs> <d: PreFuncDecl> => { v.extend(d); v },
    <mut v: LeadingFuncs> <m: ModuleDef> => { v.push(m); v },
};

ModuleDef: Stmt = {
    KW_MODULE <mn: Ident> <mb: Stmts> KW_END KW_MODULE <_emn: END_UNIT_NAME?> => Stmt::Module { name: mn, body: mb },
    KW_MODULE <mn: Ident> <mb: Stmts> KW_CONTAINS <contained: FuncList> KW_END KW_MODULE <_emn: END_UNIT_NAME?> => { let mut all = mb; all.extend(contained); Stmt::Module { name: mn, body: all } },
};

pub Program: Program = {
    <_end: UnnamedEnd> <post: FuncList> => Program { name: "main".to_string(), body: post },
    <mut body: UnnamedMainBody> <_end: UnnamedEnd> <post: FuncList> => {
        body.extend(post); Program { name: "main".to_string(), body }
    },
    <mut body: UnnamedMainBody> KW_CONTAINS <contained: FuncList> <_end: UnnamedEnd> => {
        body.extend(contained); Program { name: "main".to_string(), body }
    },
    <pre: LeadingFuncs> KW_PROGRAM <name: Ident> <body: Stmts> <_end: ProgramEnd> <post: FuncList> => {
        let mut all = pre; all.extend(body); all.extend(post); Program { name, body: all }
    },
    <pre: LeadingFuncs> KW_PROGRAM <name: Ident> <body: Stmts> KW_CONTAINS <contained: FuncList> <_end: ProgramEnd> => {
        let mut all = pre; all.extend(body); all.extend(contained); Program { name, body: all }
    },
    KW_PROGRAM <name: Ident> <body: Stmts> KW_CONTAINS <contained: FuncList> <_end: ProgramEnd> => {
        let mut all = body; all.extend(contained); Program { name, body: all }
    },
    KW_PROGRAM <name: Ident> <body: Stmts> <_end: ProgramEnd> <funcs: FuncList> => {
        let mut all = body; all.extend(funcs); Program { name, body: all }
    },
    <only: LeadingFuncs> => Program { name: "<anon>".to_string(), body: only },
};

// Share the declaration prefix with explicitly named programs and library units.
// The following executable/specification statement or END identifies an unnamed main.
UnnamedMainBody: Vec<Stmt> = {
    <pre: LeadingFuncs> => pre,
    <pos:@L> <first: Stmt> <rest: Stmts> => { let mut body = vec![Stmt::SourceLocation(pos), first]; body.extend(rest); body },
    <mut pre: LeadingFuncs> <pos:@L> <first: Stmt> <rest: Stmts> => { pre.push(Stmt::SourceLocation(pos)); pre.push(first); pre.extend(rest); pre },
    <pos:@L> <label:LABEL> <first:Stmt> <rest:Stmts> => {
        let mut body=vec![Stmt::SourceLocation(pos),Stmt::CallSub{name:"@statement_label".into(),args:vec![Expr::IntLit(label)]},first];
        body.extend(rest); body
    },
    <mut pre:LeadingFuncs> <pos:@L> <label:LABEL> <first:Stmt> <rest:Stmts> => {
        pre.extend([Stmt::SourceLocation(pos),Stmt::CallSub{name:"@statement_label".into(),args:vec![Expr::IntLit(label)]},first]);
        pre.extend(rest); pre
    },
};

UnnamedEnd: () = {
    BARE_END => (),
    KW_END KW_PROGRAM => (),
};

FuncList: Vec<Stmt> = {
    /* empty */ => vec![],
    <v: FuncList> <f: FuncDef> => { let mut v = v; v.push(f); v },
    <v: FuncList> <s: SubrDef> => { let mut v = v; v.push(s); v },
    <v: FuncList> <d: PreFuncDecl> => { let mut v = v; v.extend(d); v },
};

FuncDef: Stmt = {
    <pos:@L> <prefix: FunctionPrefix> <mut function: FunctionDef> => {
        if let Stmt::Function { pure, elemental, body, .. } = &mut function { *pure = prefix.0; *elemental = prefix.1; body.insert(0,Stmt::SourceLocation(pos)); }
        function
    },
};

#[inline]
FunctionPrefix: (bool,bool) = {
    <prefix:ProcedureModifier*> =>? {
        let pure=prefix.iter().any(|p|p.0==Some(true));
        let impure=prefix.iter().any(|p|p.0==Some(false));
        let elemental=prefix.iter().any(|p|p.1);
        if pure && impure {
            Err(lalrpop_util::ParseError::User {error:"a procedure cannot specify both PURE and IMPURE"})
        } else {
            Ok((pure || elemental && !impure,elemental))
        }
    },
};
ProcedureModifier: (Option<bool>,bool) = {
    KW_PURE => (Some(true),false),
    KW_IMPURE => (Some(false),false),
    KW_ELEMENTAL => (None,true),
    KW_RECURSIVE => (None,false),
};

FunctionDef: Stmt = {
    <kind: TypeSpec> KW_FUNCTION <name: Ident> LPAREN <params: ParamList> RPAREN KW_RESULT LPAREN <result: Ident> RPAREN <mut body:ProcedureBody> <_end: FunctionEnd> => {
        body.insert(0, Stmt::VarDecl { kind, names: vec![result.clone()] });
        crate::ast::function_with_result(name, params, result, body)
    },
    <kind: TypeSpec> KW_FUNCTION <name: Ident> LPAREN <params: ParamList> RPAREN <mut body:ProcedureBody> <_end: FunctionEnd> => {
        body.insert(0,Stmt::VarDecl {kind:kind.clone(),names:vec![name.clone()]});
        Stmt::Function { name, params, return_type:Some(kind),body,pure:false,elemental:false }
    },
    KW_FUNCTION <name: Ident> LPAREN <params: ParamList> RPAREN KW_RESULT LPAREN <result: Ident> RPAREN <body:ProcedureBody> <_end: FunctionEnd> => crate::ast::function_with_result(name, params, result, body),
    KW_FUNCTION <name: Ident> LPAREN <params: ParamList> RPAREN <body:ProcedureBody> <_end: FunctionEnd> => Stmt::Function { name, params, return_type: None, body, pure: false, elemental:false },
};

SubrDef: Stmt = {
    <pos:@L> <prefix: FunctionPrefix> KW_SUBROUTINE <name: Ident> LPAREN <params: ParamList> RPAREN <mut body:ProcedureBody> <_end: SubroutineEnd> => {
        body.insert(0,Stmt::SourceLocation(pos));
        Stmt::Subroutine { name, params, body, pure: prefix.0, elemental: prefix.1 }
    },
};

FunctionEnd: () = {
    BARE_END => (),
    KW_END KW_FUNCTION END_UNIT_NAME? => (),
};
SubroutineEnd: () = {
    BARE_END => (),
    KW_END KW_SUBROUTINE END_UNIT_NAME? => (),
};
ProgramEnd: () = {
    BARE_END => (),
    KW_END KW_PROGRAM END_UNIT_NAME? => (),
};

Ident: String = { <s:ID> => s };

ComponentName: String = { <n:Ident> => n, KW_PRINT => "print".into() };
Designator: String = {
    <n:Ident> => n,
    <n:Designator> PERCENT <c:ComponentName> => format!("{n}%{c}"),
};
Bindings: Vec<(String,String)> = {
    => vec![],
    <mut bindings:Bindings> KW_PROCEDURE DCOLON <items:BindingList> => {bindings.extend(items);bindings},
};
BindingList: Vec<(String,String)> = {
    <item:Binding> => vec![item],
    <mut items:BindingList> COMMA <item:Binding> => {items.push(item);items},
};
Binding: (String,String) = {
    <n:ComponentName> => (n.clone(),n),
    <n:ComponentName> ARROW <target:Ident> => (n,target),
};
Components: Vec<Stmt> = {
    => vec![],
    <mut body:Components> <decl:PreFuncDecl> => {body.extend(decl);body},
};

IdentList: Vec<String> = {
    <id: Ident> => vec![id],
    <mut v: IdentList> COMMA <id: Ident> => { v.push(id); v },
};

Operator: String = {
    <name:DEFINED_OP> => name,
    PLUS => "+".into(), MINUS => "-".into(), STAR => "*".into(),
    SLASH => "/".into(), POW => "**".into(), CONCAT => "//".into(),
    EQEQ => "==".into(), NE => "/=".into(), LT => "<".into(), LE => "<=".into(),
    GT => ">".into(), GE => ">=".into(), AND => ".and.".into(), OR => ".or.".into(),
    NOT => ".not.".into(), EQV => ".eqv.".into(), NEQV => ".neqv.".into(),
};
GenericName: String = {
    <n:Ident> => n,
    KW_OPERATOR LPAREN <op:Operator> RPAREN => format!("operator({op})"),
};
GenericNames: Vec<String> = {
    <n:GenericName> => vec![n],
    <mut names:GenericNames> COMMA <n:GenericName> => {names.push(n);names},
};
OperatorProcedures: Vec<String> = {
    KW_MODULE KW_PROCEDURE <names:IdentList> => names,
    <mut names:OperatorProcedures> KW_MODULE KW_PROCEDURE <more:IdentList> => {names.extend(more);names},
};
EndOperator: String = { KW_OPERATOR LPAREN <op:Operator> RPAREN => op };

// attribute list used in declarations, e.g. `integer, intent(in) :: a`.
AttrList: Vec<String> = {
    <mut v: AttrList> COMMA KW_PUBLIC => { v.push("public".into()); v },
    <mut v: AttrList> COMMA KW_PRIVATE => { v.push("private".into()); v },
    /* empty */ => vec![],
    <mut v: AttrList> COMMA <id: Ident> LPAREN <arg: Ident> RPAREN => { v.push(format!("{}({})", id, arg)); v },
    <mut v: AttrList> COMMA <id: Ident> => { v.push(id); v },
};

// DIMENSION uses the same bounds as entity declarators, while the remaining
// attributes keep their existing representation (INTENT, PARAMETER, etc.).
IntrinsicAttrList: (Vec<String>, Option<Vec<Expr>>) = {
    <attrs:AttrList> => (attrs,None),
    <mut before:AttrList> COMMA KW_DIMENSION LPAREN <dims:DimList> RPAREN <after:AttrList> => {
        before.extend(after);
        (before,Some(dims))
    },
};

// Attributes and initialization require ::; simple declarations may omit it.
IntrinsicDeclHead: (TypeSpec, Vec<String>, Option<Vec<Expr>>, bool) = {
    <t:TypeSpec> <attributes:IntrinsicAttrList> DCOLON => (t,attributes.0,attributes.1,true),
    <t:TypeSpec> => (t,vec![],None,false),
};

DeclEntities: Vec<(String, Vec<Expr>, Option<Expr>, Option<TypeSpec>)> = {
    <e: DeclEntity> => vec![e],
    <mut v: DeclEntities> COMMA <e: DeclEntity> => { v.push(e); v },
};

DeclEntity: (String, Vec<Expr>, Option<Expr>, Option<TypeSpec>) = {
    <name:Ident> STAR <length:EntityCharLength> => (name,vec![],None,Some(length)),
    <name:Ident> STAR <length:EntityCharLength> EQ <value:RhsExpr> => (name,vec![],Some(value),Some(length)),
    <name:Ident> LPAREN <dims:DimList> RPAREN STAR <length:EntityCharLength> => (name,dims,None,Some(length)),

    <name: Ident> => (name, vec![], None, None),
    <name: Ident> EQ <value: RhsExpr> => (name, vec![], Some(value), None),
    <name: Ident> LPAREN <dims: DimList> RPAREN => (name, dims, None, None),
    <name: Ident> LPAREN <dims: DimList> RPAREN EQ <value: RhsExpr> => (name, dims, Some(value), None),
};

EntityCharLength: TypeSpec = {
    <n:INT> => crate::ast::character_length(Expr::IntLit(n)),
    LPAREN <n:RhsExpr> RPAREN => crate::ast::character_length(n),
    LPAREN STAR RPAREN => TypeSpec::CharacterAssumed,
};

Stmts: Vec<Stmt> = {
    /* empty */ => vec![],
    <v: Stmts> <pos:@L> <s: Stmt> => { let mut v = v; v.push(Stmt::SourceLocation(pos)); v.push(s); v },
    <mut v: Stmts> <d: PreFuncDecl> => { v.extend(d); v },
    <mut v:Stmts> <pos:@L> <label:LABEL> <s:Stmt> => {
        v.extend([Stmt::SourceLocation(pos),Stmt::CallSub{name:"@statement_label".into(),args:vec![Expr::IntLit(label)]},s]); v
    },
};

Stmt: Stmt = {
    KW_PARAMETER LPAREN <entities:ParameterEntities> RPAREN => Stmt::InitializedDecl {
        kind:TypeSpec::Integer(None), attributes:vec!["parameter".into(),"@separate_parameter".into()], entities,
    },
    <op:FILE_CONTROL> LPAREN <args:IoControls> RPAREN => Stmt::CallSub { name:format!("@io_{op}"), args },
    <op:FILE_POSITION> <unit:RhsExpr> => Stmt::CallSub { name:format!("@io_{op}"), args:vec![unit] },
    KW_INTERFACE <name:Ident> <procedures:OperatorProcedures> KW_END KW_INTERFACE <end_name:END_INTERFACE_NAME?> => Stmt::GenericInterface { name, procedures, end_name },
    KW_INTERFACE KW_OPERATOR LPAREN <operator:Operator> RPAREN <procedures:OperatorProcedures> KW_END KW_INTERFACE <end_operator:EndOperator?> => Stmt::OperatorInterface { operator, procedures, end_operator },
    KW_ERROR KW_STOP <arg: RhsExpr> => Stmt::CallSub { name: "@error_stop".into(), args: vec![arg] },
    KW_ALLOCATE LPAREN <args: CallArgList> RPAREN => Stmt::CallSub { name: "@allocate".into(), args },
    KW_DEALLOCATE LPAREN <args: CallArgList> RPAREN => Stmt::CallSub { name: "@deallocate".into(), args },
    KW_NULLIFY LPAREN <args:CallArgList> RPAREN => Stmt::CallSub{name:"@nullify".into(),args},
    KW_WRITE LPAREN <controls:WriteControls> RPAREN <items:ExprList> =>? {
        crate::output::write_controls(controls,items)
            .map_err(|error|lalrpop_util::ParseError::User {error})
    },
    KW_WRITE_EMPTY LPAREN <controls:WriteControls> RPAREN =>?
        crate::output::write_controls(controls,vec![])
            .map_err(|error|lalrpop_util::ParseError::User {error}),
    KW_PRINT <fmt: RhsExpr> COMMA <items: ExprList> => { let mut args = vec![fmt]; args.extend(items); Stmt::CallSub { name: "@formatted_print".into(), args } },
    KW_PUBLIC => Stmt::Accessibility { public: true, names: vec![] },
    KW_PRIVATE => Stmt::Accessibility { public: false, names: vec![] },
    KW_PUBLIC DCOLON <names: GenericNames> => Stmt::Accessibility { public: true, names },
    KW_PRIVATE DCOLON <names: GenericNames> => Stmt::Accessibility { public: false, names },
    KW_PRINT STAR COMMA <es: ExprList> => Stmt::Print { items: es },
    KW_PRINT_EMPTY STAR => Stmt::Print { items: vec![] },
    KW_PRINT COMMA STAR COMMA <es: ExprList> => Stmt::Print { items: es },
    KW_PRINT LPAREN STAR COMMA <es: ExprList> RPAREN => Stmt::Print { items: es },
    KW_READ_EMPTY LPAREN <controls:ReadControls> RPAREN =>?
        crate::input::read_controls(controls,vec![])
            .map_err(|error|lalrpop_util::ParseError::User {error}),
    KW_READ LPAREN <controls:ReadControls> RPAREN <items:ExprList> =>?
        crate::input::read_controls(controls,items)
            .map_err(|error|lalrpop_util::ParseError::User {error}),
    KW_READ STAR COMMA STAR COMMA <es: ExprList> => {
        let mut cloned: Vec<Expr> = Vec::new();
        for e in &es { cloned.push(e.clone()); }
        Stmt::Read { args: cloned }
    },
    KW_CALL <name: Designator> LPAREN <args: CallArgList> RPAREN => Stmt::CallSub { name, args },
    // Single-line IF: executes a single statement when condition true, e.g. `if (cond) cycle`
    KW_IF LPAREN <cnd: CondExpr> RPAREN <s: Stmt> => {
        let mut v = Vec::new(); v.push(s); Stmt::If { cond: cnd, then_body: v, else_body: None }
    },
    KW_IF LPAREN <cnd: CondExpr> RPAREN KW_THEN <then_stmts: Stmts> <tail:IfTail> => Stmt::If { cond: cnd, then_body: then_stmts, else_body: tail },
    KW_WHERE LPAREN <mask:CondExpr> RPAREN <assignment:Stmt> =>
        Stmt::Block { body: vec![Stmt::CallSub { name:"@where".into(), args:vec![mask] }, assignment] },
    KW_WHERE_BLOCK LPAREN <mask:CondExpr> RPAREN <body:Stmts> <tail:WhereTail> => {
        let mut statements=vec![Stmt::CallSub {name:"@where".into(),args:vec![mask]}];
        statements.extend(body); statements.extend(tail);
        Stmt::Block {body:statements}
    },
    KW_FORALL LPAREN <controls:ForallControls> RPAREN <assignment:Stmt> => {
        // A private marker keeps ordinary scope/expression passes traversing the
        // assignment until static shapes are known and simultaneous writes lower.
        Stmt::Block { body: vec![Stmt::CallSub {name:"@forall".into(),args:controls},assignment] }
    },
    <name:LoopName?> <stmt:DoLoop> <end:END_LOOP_NAME?> => crate::named_loops::parsed(stmt,name,end),
    KW_RETURN => Stmt::Return(None),
    <name: Designator> EQ <rhs: RhsExpr> => Stmt::Assign { name, value: rhs },
    <name:Designator> ARROW <target:RhsExpr> => Stmt::CallSub {name:"@pointer_associate".into(),args:vec![Expr::Ident(name),target]},
    <id: Designator> LPAREN <args: SubscriptList> RPAREN LPAREN <range: Subscript> RPAREN EQ <rhs: RhsExpr> =>
        Stmt::CallSub {name:"@array_substring_assign".into(), args:vec![crate::ast::section_or_call(id,args),range,rhs]},
    <id: Designator> LPAREN <args: SubscriptList> RPAREN EQ <rhs: RhsExpr> => {
        let expr = crate::ast::section_or_call(id.clone(), args);
        let indices = match expr { Expr::Section { .. } => vec![expr], Expr::Call(_, args) => args.into_iter().map(|e| if matches!(e,Expr::Section {..}) { Expr::Call("@vector_subscript".into(),vec![e]) } else {e}).collect(), _ => unreachable!() };
        Stmt::AssignIndex { name: id, indices, value: rhs }
    },
    KW_USE <head:UseHead> <only:UseOnly> => Stmt::Use { module:head.0, nature:head.1, only },
    KW_IMPLICIT KW_NONE => Stmt::Implicit(Implicit::None),
    KW_IMPLICIT <rules: ImplicitRuleList> => {
        if rules.len() == 1 {
            let rule = &rules[0];
            Stmt::Implicit(Implicit::Rule { 
                type_spec: rule.type_spec.clone(), 
                letter_ranges: rule.letter_ranges.clone() 
            })
        } else {
            Stmt::Implicit(Implicit::Rules { rules })
        }
    },
    KW_SELECT KW_CASE LPAREN <e: RhsExpr> RPAREN <case_blocks: CaseBlocks> KW_END KW_SELECT => {
        let mut default: Option<Vec<Stmt>> = None;
        let mut blocks: Vec<CaseBlock> = Vec::new();
        for cb in case_blocks {
            match cb {
                CaseOrDefault::Case(b) => blocks.push(b),
                CaseOrDefault::Default(d) => default = Some(d),
            }
        }
        Stmt::SelectCase { expr: e, cases: blocks, default }
    },
    KW_BLOCK <body: Stmts> KW_END KW_BLOCK => Stmt::Block { body },
    <name:NAMED_EXIT> => Stmt::CallSub {name:"@named_exit".into(),args:vec![Expr::Str(name)]},
    <name:NAMED_CYCLE> => Stmt::CallSub {name:"@named_cycle".into(),args:vec![Expr::Str(name)]},
    KW_EXIT => Stmt::Exit,
    KW_CYCLE => Stmt::Cycle,
    KW_CONTINUE => Stmt::CallSub{name:"@continue".into(),args:vec![]},
    KW_STOP_EMPTY => Stmt::CallSub { name: "@stop".into(), args: vec![] },
    KW_STOP <arg: RhsExpr> => Stmt::CallSub { name: "@stop".into(), args: vec![arg] },
};

ParamList: Vec<String> = {
    /* empty */ => vec![],
    <id: Ident> => vec![id],
    <mut v: ParamList> COMMA <id: Ident> => { v.push(id); v },
};

CondExpr: Expr = { <e: RhsExpr> => e };

IoControls: Vec<Expr> = {
    <arg:IoControl> => vec![arg],
    <mut args:IoControls> COMMA <arg:IoControl> => {args.push(arg);args},
};
IoControl: Expr = {
    <key:Ident> EQ <value:RhsExpr> => Expr::Call(format!("@io_spec:{key}"),vec![value]),
    <value:RhsExpr> => value,
};

TypeSpec: TypeSpec = {
    KW_REAL LPAREN KW_KIND EQ <kind: Ident> RPAREN => TypeSpec::RealKind(kind),
    KW_REAL LPAREN KW_KIND EQ <kind: INT> RPAREN => TypeSpec::RealKind(kind),
    KW_REAL LPAREN <kind: Ident> RPAREN => TypeSpec::RealKind(kind),
    KW_REAL LPAREN <kind: INT> RPAREN => TypeSpec::RealKind(kind),
    KW_INTEGER => TypeSpec::Integer(None),
    KW_INTEGER LPAREN KW_KIND EQ <kind: Ident> RPAREN => TypeSpec::IntegerKind(kind),
    KW_INTEGER LPAREN KW_KIND EQ <kind: INT> RPAREN => TypeSpec::IntegerKind(kind),
    KW_INTEGER LPAREN <kind: Ident> RPAREN => TypeSpec::IntegerKind(kind),
    KW_INTEGER LPAREN <k: INT> RPAREN => {
        match k.parse::<u8>() { Ok(k) => TypeSpec::Integer(Some(k)), Err(_) => TypeSpec::IntegerKind(k) }
    },
    KW_REAL => TypeSpec::Real,
    KW_DOUBLE KW_PRECISION => TypeSpec::DoublePrecision,
    KW_CHARACTER => TypeSpec::Character(None),
    KW_CHARACTER LPAREN KW_LEN EQ COLON RPAREN => crate::ast::character_length(Expr::Ident("@deferred_character".into())),
    KW_CHARACTER LPAREN COLON RPAREN => crate::ast::character_length(Expr::Ident("@deferred_character".into())),
    KW_CHARACTER LPAREN KW_LEN EQ STAR RPAREN => TypeSpec::CharacterAssumed,
    KW_CHARACTER LPAREN STAR RPAREN => TypeSpec::CharacterAssumed,
    KW_CHARACTER LPAREN KW_LEN EQ <length:RhsExpr> RPAREN => crate::ast::character_length(length),
    KW_CHARACTER LPAREN <length:RhsExpr> RPAREN => crate::ast::character_length(length),
    KW_LOGICAL => TypeSpec::Logical,
};

ConstructorType: TypeSpec = {
    KW_REAL => TypeSpec::Real,
    KW_REAL LPAREN <args:CallArgList> RPAREN =>? crate::empty_constructors::real_kind(args)
        .map_err(|error|lalrpop_util::ParseError::User {error}),
    KW_INTEGER => TypeSpec::Integer(None),
    KW_INTEGER LPAREN KW_KIND EQ <kind: Ident> RPAREN => TypeSpec::IntegerKind(kind),
    KW_INTEGER LPAREN KW_KIND EQ <kind: INT> RPAREN => TypeSpec::IntegerKind(kind),
    KW_INTEGER LPAREN <kind: Ident> RPAREN => TypeSpec::IntegerKind(kind),
    KW_INTEGER LPAREN <k: INT> RPAREN => {
        match k.parse::<u8>() { Ok(k) => TypeSpec::Integer(Some(k)), Err(_) => TypeSpec::IntegerKind(k) }
    },
    KW_DOUBLE KW_PRECISION => TypeSpec::DoublePrecision,
    KW_CHARACTER => TypeSpec::Character(None),
    KW_CHARACTER LPAREN KW_LEN EQ COLON RPAREN => crate::ast::character_length(Expr::Ident("@deferred_character".into())),
    KW_CHARACTER LPAREN COLON RPAREN => crate::ast::character_length(Expr::Ident("@deferred_character".into())),
    KW_CHARACTER LPAREN KW_LEN EQ STAR RPAREN => TypeSpec::CharacterAssumed,
    KW_CHARACTER LPAREN STAR RPAREN => TypeSpec::CharacterAssumed,
    KW_CHARACTER LPAREN KW_LEN EQ <length:RhsExpr> RPAREN => crate::ast::character_length(length),
    KW_CHARACTER LPAREN <length:RhsExpr> RPAREN => crate::ast::character_length(length),
    KW_LOGICAL => TypeSpec::Logical,
};

// Separate type spec rule for implicit statements to avoid conflicts
ImplicitTypeSpec: TypeSpec = {
    KW_INTEGER => TypeSpec::Integer(None),
    KW_REAL => TypeSpec::Real,
    KW_DOUBLE KW_PRECISION => TypeSpec::DoublePrecision,
    KW_CHARACTER => TypeSpec::Character(None),
    KW_LOGICAL => TypeSpec::Logical,
};

ExprList: Vec<Expr> = {
    <e: RhsExpr> => vec![e],
    <mut v: ExprList> COMMA <e: RhsExpr> => { v.push(e); v },
};

ImpliedDoStep: Expr = { COMMA <e:RhsExpr> => e };

RhsExpr: Expr = {
    <e: OrExpr> => e,
    <l: RhsExpr> <op: DEFINED_OP> <r: OrExpr> => Expr::Call(format!("@defined_operator:{op}"), vec![l, r]),
};

// Precedence climbing
OrExpr: Expr = {
    <l: AndExpr> => l,
    <l: OrExpr> OR <r: AndExpr> => Expr::or(l, r),
};

AndExpr: Expr = {
    <l: EqvExpr> => l,
    <l: AndExpr> AND <r: EqvExpr> => Expr::and(l, r),
};

EqvExpr: Expr = {
    <l: RelExpr> => l,
    <l: EqvExpr> EQV <r: RelExpr> => Expr::eqv(l, r),
    <l: EqvExpr> NEQV <r: RelExpr> => Expr::neqv(l, r),
};

RelExpr: Expr = {
    <l: ConcatExpr> => l,
    <l: RelExpr> EQEQ <r: ConcatExpr> => Expr::eq(l, r),
    <l: RelExpr> NE <r: ConcatExpr> => Expr::ne(l, r),
    <l: RelExpr> LT <r: ConcatExpr> => Expr::lt(l, r),
    <l: RelExpr> GT <r: ConcatExpr> => Expr::gt(l, r),
    <l: RelExpr> LE <r: ConcatExpr> => Expr::le(l, r),
    <l: RelExpr> GE <r: ConcatExpr> => Expr::ge(l, r),
};

ConcatExpr: Expr = {
    <l: AddExpr> => l,
    <l: ConcatExpr> CONCAT <r: AddExpr> => Expr::concat(l, r),
};

AddExpr: Expr = {
    <l: MulExpr> => l,
    <l: AddExpr> PLUS <r: MulExpr> => Expr::add(l, r),
    <l: AddExpr> MINUS <r: MulExpr> => Expr::sub(l, r),
};

MulExpr: Expr = {
    <l: UnaryExpr> => l,
    <l: MulExpr> STAR <r: UnaryExpr> => Expr::mul(l, r),
    <l: MulExpr> SLASH <r: UnaryExpr> => Expr::div(l, r),
};

PowExpr: Expr = {
    <l: PowerBase> => l,
    <l: PowerBase> POW <r: UnaryExpr> => Expr::pow(l, r),
};

PowerBase: Expr = {
    <p: Primary> => p,
    <op: DEFINED_OP> <p: Primary> => Expr::Call(format!("@defined_operator:{op}"), vec![p]),
};

UnaryExpr: Expr = {
    <p: PowExpr> => p,
    PLUS <p: UnaryExpr> => Expr::Call("@unary_plus".into(), vec![p]),
    MINUS <p: UnaryExpr> => Expr::neg(p),
    NOT <p: UnaryExpr> => Expr::not(p),
};

Primary: Expr = {
    LBRACKET <items: ExprList> RBRACKET => Expr::Call("@array_constructor".into(), items),
    LBRACKET <kind:ConstructorType> DCOLON <items:ExprList?> RBRACKET =>
        crate::empty_constructors::parsed(kind,items.unwrap_or_default()),
    <n: INT> => Expr::IntLit(n),
    <f: FLOAT> => Expr::RealLit(f),
    <s: STR> => Expr::Str(s),
    <s: STR> LPAREN <range: Subscript> RPAREN => Expr::Call("@literal_substring".into(), vec![Expr::Str(s), range]),
    TRUE => Expr::Logical(true),
    FALSE => Expr::Logical(false),
    // Ident(args) can be either a function call or an array indexing expression;
    // treat it as a function call here (Expr::Call). Array element assignment is
    // handled at the statement level by the AssignIndex rule above.
    <id: Designator> LPAREN <args: SubscriptList> RPAREN => crate::ast::section_or_call(id, args),
    <id: Designator> LPAREN <args: SubscriptList> RPAREN LPAREN <range: Subscript> RPAREN =>
        Expr::Call("@array_substring".into(),vec![crate::ast::section_or_call(id,args),range]),
    KW_REAL LPAREN <args: CallArgList> RPAREN => Expr::Call("real".to_string(), args),
    <id: Designator> => Expr::Ident(id),
    LPAREN <e: RhsExpr> RPAREN => e,
    LPAREN <items:ExprList> COMMA <var:Ident> EQ <start:RhsExpr> COMMA <end:RhsExpr> <step:ImpliedDoStep?> RPAREN => {
        let mut args=vec![Expr::Ident(var),start,end,step.unwrap_or(Expr::IntLit("1".into()))];
        args.extend(items);Expr::Call("@output_implied_do".into(),args)
    },
};

ReadControls: Vec<Expr> = { <first:ReadControl> <rest:(COMMA <ReadControl>)*> => {
    let mut args=vec![first];args.extend(rest);args
} };
ReadControl: Expr = {
    <name:Ident> EQ <value:WriteValue> => Expr::Call(format!("@read_control:{name}"),vec![value]),
    KW_END EQ <value:RhsExpr> => Expr::Call("@read_control:end".into(),vec![value]),
    <value:WriteValue> => value,
};

WriteControls: Vec<Expr> = { <first:WriteControl> <rest:(COMMA <WriteControl>)*> => {
    let mut args=vec![first];args.extend(rest);args
} };
WriteControl: Expr = {
    <name:Ident> EQ <value:WriteValue> => Expr::Call(format!("@write_control:{name}"),vec![value]),
    <value:WriteValue> => value,
};
WriteValue: Expr = { STAR => Expr::Call("@write_star".into(),vec![]), <value:RhsExpr> => value };

ForallControls: Vec<Expr> = {
    <first:ForallControl> <rest:(COMMA <ForallControl>)*> => {
        let mut controls = first;
        for control in rest { controls.extend(control); }
        controls
    },
};
ForallControl: Vec<Expr> = {
    <index:Ident> EQ <start:RhsExpr> COLON <end:RhsExpr> <step:ForallStride?> =>
        vec![Expr::Ident(index), start, end, step.unwrap_or(Expr::IntLit("1".into()))],
};
ForallStride: Expr = { COLON <e:RhsExpr> => e };

SubscriptList: Vec<Expr> = {
    => vec![],
    <e: Subscript> => vec![e],
    <mut v: SubscriptList> COMMA <e: Subscript> => { v.push(e); v },
};
Subscript: Expr = {
    <name:KeywordName> EQ <value:RhsExpr> => Expr::Call(format!("@keyword:{name}"), vec![value]),
    <e: RhsExpr> => e,
    <lower: RhsExpr?> COLON <upper: RhsExpr?> => Expr::Section { name: String::new(), lower: lower.map(Box::new), upper: upper.map(Box::new), stride: None },
    <lower: RhsExpr?> COLON <upper: RhsExpr?> COLON <stride: RhsExpr> => Expr::Section { name: String::new(), lower: lower.map(Box::new), upper: upper.map(Box::new), stride: Some(Box::new(stride)) },
    <lower: RhsExpr?> DCOLON <stride: RhsExpr> => Expr::Section { name: String::new(), lower: lower.map(Box::new), upper: None, stride: Some(Box::new(stride)) },
};

KeywordName: String = { <name:Ident> => name, KW_KIND => "kind".into() };

CallArgList: Vec<Expr> = {
    /* empty */ => vec![],
    <e: CallArgument> => vec![e],
    <mut v: CallArgList> COMMA <e: CallArgument> => { v.push(e); v },
};
CallArgument: Expr = {
    <name:KeywordName> EQ <value:RhsExpr> => Expr::Call(format!("@keyword:{name}"), vec![value]),
    <e:RhsExpr> => e,
};

ArrayDeclList: Vec<Stmt> = {
    <a: ArrayDecl> => vec![a],
    <mut v: ArrayDeclList> COMMA <a: ArrayDecl> => { v.push(a); v },
};

ArrayDecl: Stmt = {
    <id: Ident> LPAREN <dims: DimList> RPAREN => {
        // placeholder: we cannot construct ArrayDecl directly without TypeSpec here
        // return a VarDecl with empty names to be rewritten later in sema
        Stmt::VarDecl { kind: TypeSpec::Integer(None), names: vec![id] }
    }
};

DimList: Vec<Expr> = {
    <d:DeclaredDimension> => vec![d],
    <mut v:DimList> COMMA <d:DeclaredDimension> => { v.push(d); v },
};
DeclaredDimension: Expr = {
    STAR => Expr::Ident("@assumed_extent".into()),
    COLON => Expr::Ident("@deferred_extent".into()),
    <e:RhsExpr> => e,
    <lower:RhsExpr> COLON <upper:RhsExpr> => Expr::Call("@declared_bounds".into(),vec![lower,upper]),
};

CaseBlocks: Vec<CaseOrDefault> = {
    CaseBlockRule* => <>,
};

CaseBlockRule: CaseOrDefault = {
    KW_CASE KW_DEFAULT <body: Stmts> => CaseOrDefault::Default(body),
    KW_CASE LPAREN <items: CaseItemList> RPAREN <body: Stmts> => CaseOrDefault::Case(CaseBlock { items, body }),
    KW_DEFAULT <body: Stmts> => CaseOrDefault::Default(body),
};

CaseItemList: Vec<CaseItem> = {
    <it: CaseItem> => vec![it],
    <mut v: CaseItemList> COMMA <it: CaseItem> => { v.push(it); v },
};

ParameterEntities: Vec<(String, Option<Expr>)> = {
    <name:Ident> EQ <value:RhsExpr> => vec![(name,Some(value))],
    <mut entities:ParameterEntities> COMMA <name:Ident> EQ <value:RhsExpr> => { entities.push((name,Some(value))); entities },
};

CaseItem: CaseItem = {
    <l: RhsExpr> COLON <r: RhsExpr> => CaseItem::Range(l, r),
    COLON <r: RhsExpr> => CaseItem::Range(Expr::Call("@case_unbounded".into(),vec![]), r),
    <l: RhsExpr> COLON => CaseItem::Range(l, Expr::Call("@case_unbounded".into(),vec![])),
    <e: RhsExpr> => CaseItem::Single(e),
};

PreFuncDecl: Vec<Stmt> = {
    <pos:@L> <declarations:PreFuncDeclData> => {
        let mut body=vec![Stmt::SourceLocation(pos)];body.extend(declarations);body
    },
};
PreFuncDeclData: Vec<Stmt> = {
    KW_TYPE DCOLON <name:Ident> <components:Components> KW_END KW_TYPE <_end:Ident> => vec![Stmt::DerivedType{name,components,bindings:vec![]}],
    KW_TYPE DCOLON <name:Ident> <components:Components> KW_CONTAINS <bindings:Bindings> KW_END KW_TYPE <_end:Ident> => vec![Stmt::DerivedType{name,components,bindings}],
    KW_TYPE LPAREN <type_name:Ident> RPAREN <attributes:AttrList> DCOLON <names:IdentList> => vec![Stmt::DerivedDecl{type_name,names,attributes,polymorphic:false}],
    KW_CLASS LPAREN <type_name:Ident> RPAREN <attributes:AttrList> DCOLON <names:IdentList> => vec![Stmt::DerivedDecl{type_name,names,attributes,polymorphic:true}],
    <head:IntrinsicDeclHead> <entities:DeclEntities> =>? {
        let (t,attrs,dimension,has_colons) = head;
        if !has_colons && entities.iter().any(|(_,_,value,_)| value.is_some()) {
            return Err(lalrpop_util::ParseError::User {error:"declaration initialization requires `::`"});
        }
        Ok(entities.into_iter().flat_map(|(name, dims, value, length)| {
            let dims = if dims.is_empty() { dimension.clone().unwrap_or_default() } else { dims };
            let t = match length {
                Some(length) if matches!(t,TypeSpec::Character(_) | TypeSpec::CharacterLength(_) | TypeSpec::CharacterAssumed) => length,
                Some(_) => crate::ast::character_length(Expr::Call("@invalid_entity_length".into(),vec![])),
                None => t.clone(),
            };
            let mut declarations = Vec::new();
            for attr in &attrs {
                if attr.to_ascii_lowercase().starts_with("intent(") || matches!(attr.to_ascii_lowercase().as_str(), "optional" | "allocatable" | "parameter" | "pointer" | "target") {
                    declarations.push(Stmt::DummyIntent { name: name.clone(), intent: attr.to_ascii_lowercase() });
                }
            }
            let declaration = if dims.is_empty() {
                crate::ast::scalar_decl(t.clone(), attrs.clone(), vec![(name, value)])
            } else {
                if value.is_some() { declarations.push(crate::ast::scalar_decl(t.clone(), attrs.clone(), vec![(name.clone(), value)])); }
                Stmt::ArrayDecl { kind: t.clone(), name, dims }
            };
            declarations.push(declaration);
            declarations
        }).collect())
    }
};

ImplicitRuleList: Vec<ImplicitRule> = {
    <rule: ImplicitRuleItem> => vec![rule],
    <mut v: ImplicitRuleList> COMMA <rule: ImplicitRuleItem> => { v.push(rule); v },
};

ImplicitRuleItem: ImplicitRule = {
    <t: ImplicitTypeSpec> LPAREN <ranges: LetterRangeList> RPAREN => ImplicitRule {
        type_spec: t,
        letter_ranges: ranges,
    },
};

LetterRangeList: Vec<LetterRange> = {
    <lr: LetterRangeItem> => vec![lr],
    <mut v: LetterRangeList> COMMA <lr: LetterRangeItem> => { v.push(lr); v },
};

LetterRangeItem: LetterRange = {
    <start: Ident> => {
        let start_char = start.chars().next().unwrap_or('a').to_ascii_lowercase();
        LetterRange { start: start_char, end: None }
    },
    <start: Ident> MINUS <end: Ident> => {
        let start_char = start.chars().next().unwrap_or('a').to_ascii_lowercase();
        let end_char = end.chars().next().unwrap_or('z').to_ascii_lowercase();
        LetterRange { start: start_char, end: Some(end_char) }
    },
};

// Lower a branch chain to nested IF nodes, sharing a single closing END IF.
IfTail: Option<Vec<Stmt>> = {
    KW_END KW_IF => None,
    KW_ELSE <body:Stmts> KW_END KW_IF => Some(body),
    KW_ELSE_IF LPAREN <cond:CondExpr> RPAREN KW_THEN <body:Stmts> <tail:IfTail> =>
        Some(vec![Stmt::If { cond, then_body: body, else_body: tail }]),
};

WhereTail: Vec<Stmt> = {
    KW_ENDWHERE => vec![],
    KW_ELSEWHERE <body:Stmts> KW_ENDWHERE => {
        let mut result=vec![Stmt::CallSub{name:"@elsewhere".into(),args:vec![]}];
        result.extend(body); result
    },
    KW_ELSEWHERE LPAREN <mask:CondExpr> RPAREN <body:Stmts> <tail:WhereTail> => {
        let mut result=vec![Stmt::CallSub{name:"@elsewhere".into(),args:vec![mask]}];
        result.extend(body); result.extend(tail); result
    },
};

UseHead: (String, Option<String>) = {
    <m:Ident> => (m,None),
    DCOLON <m:Ident> => (m,None),
    COMMA <nature:Ident> DCOLON <m:Ident> => (m,Some(nature)),
};
UseOnly: Option<Vec<String>> = {
    => None,
    COMMA KW_ONLY COLON <names:GenericNames> => Some(names),
};

LoopName: String = { <name:CONSTRUCT_NAME> COLON => name };
DoLoop: Stmt = {
    KW_DO <var: Ident> EQ <s: RhsExpr> COMMA <e: RhsExpr> COMMA <step: RhsExpr> <body: Stmts> LoopEnd => {
        let mut statements = vec![Stmt::CallSub { name: "@do_step".into(), args: vec![Expr::Ident(var), s, e, step] }];
        statements.extend(body);
        Stmt::Block { body: statements }
    },
    KW_DO <var: Ident> EQ <s: RhsExpr> COMMA <e: RhsExpr> <body: Stmts> LoopEnd => Stmt::Do { var, start: s, end: e, body },
    KW_DO KW_WHILE LPAREN <cond: CondExpr> RPAREN <body: Stmts> LoopEnd => Stmt::DoWhile { cond, body },
    KW_DO_UNBOUNDED <body: Stmts> LoopEnd => Stmt::DoWhile { cond: Expr::Logical(true), body },
};

LoopEnd: () = { KW_END KW_DO => (), KW_ENDDO => () };

ProcedureBody: Vec<Stmt> = {
    <body:Stmts> => body,
    <mut body:Stmts> KW_CONTAINS <contained:FuncList> => {body.extend(contained);body},
};
